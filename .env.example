# ==============================================================================
# GARUDA A.S.T.R.A — CENTRAL MONOREPO CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' at the repository root:
#   cp .env.example .env
#
# Profiles:
#   - local:    Frontend (:3000) + Backend (:8000) + Localhost PostgreSQL (:5432)
#   - hybrid:   Frontend (:3000) + Backend (:8000) + Central Cloud PostgreSQL (Neon/Supabase)
#   - deployed: Deployed Frontend + Deployed Backend + Central Cloud PostgreSQL
# ==============================================================================

# --- [1] ACTIVE PROFILE ---
APP_PROFILE=hybrid
APP_ENV=development

# --- [2] DATABASE CONFIGURATION ---
# Local PostgreSQL fallback (used when working offline):
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/astra_db

# Central Cloud PostgreSQL (Shared by all developers and deployed servers):
CLOUD_DATABASE_URL=postgresql://username:password@ep-xyz.region.aws.neon.tech/astra_db?ssl=require

# Active Database URL (FastAPI Backend and Alembic connect to this):
DATABASE_URL=postgresql://username:password@ep-xyz.region.aws.neon.tech/astra_db?ssl=require

# --- [3] BACKEND SERVER & SECURITY ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=astra-tactical-secret-key-2026-v2
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS origins (JSON array string):
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://astra.vercel.app"]

# --- [4] WEB DASHBOARD (NEXT.JS) PUBLIC ENDPOINTS ---
# In 'local' and 'hybrid' mode:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/connect

# In 'deployed' mode (uncomment and set your cloud backend domain):
# NEXT_PUBLIC_API_URL=https://backend.garudaastra.dpdns.org/api/v1
# NEXT_PUBLIC_WS_URL=wss://backend.garudaastra.dpdns.org/api/v1/ws/connect

# --- [5] MOBILE PATROL APP (EXPO) ENDPOINTS ---
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/connect
